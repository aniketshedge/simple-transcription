# Optional: a read-scoped Hugging Face token, used only to download the speaker model.
# First accept https://huggingface.co/pyannote/speaker-diarization-community-1
# Never commit your actual .env file.
HF_TOKEN=

# Set to your NUC's LAN or Tailscale IP to listen only on that interface.
BIND_ADDRESS=0.0.0.0
PORT=8000
CPU_THREADS=3
MAX_FILE_MB=4096
MAX_FILES_PER_JOB=20
# Three-hour hard limit; intended for recordings typically under two hours.
MAX_DURATION_SECONDS=10800
UPLOAD_TTL_HOURS=24

